@*
    Decorative illustration: test work flowing through the stages of the journey towards a
    release. It carries no information, so it is hidden from assistive technology.
*@
<svg class="journey" viewBox="0 0 480 360" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="journey-panel" x1="0" y1="0" x2="1" y2="1">
            <stop class="journey__panel-start" offset="0" />
            <stop class="journey__panel-end" offset="1" />
        </linearGradient>
        <clipPath id="journey-clip">
            <rect width="480" height="360" rx="20" />
        </clipPath>
    </defs>
    <g clip-path="url(#journey-clip)">
        <rect width="480" height="360" fill="url(#journey-panel)" />
        <circle class="journey__glow" cx="400" cy="60" r="150" />
        <path class="journey__line journey__line--faint" d="M-10 318c90 0 120-52 190-52s110-58 180-58 130-30 130-30" />
        <path class="journey__line" d="M40 276c70 0 82-76 142-76s70-70 134-70 124-50 124-50" />
        <circle class="journey__node" cx="40" cy="276" r="7" />
        <circle class="journey__node" cx="182" cy="200" r="7" />
        <circle class="journey__node" cx="316" cy="130" r="7" />
        <circle class="journey__node journey__node--release" cx="440" cy="80" r="11" />
        <path class="journey__check" d="m434.5 80 4 4 7-8" />
    </g>
</svg>
