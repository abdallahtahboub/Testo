@page "/account/forgot-password"
@inject IStringLocalizer<WebResources> L
@inject IOptions<BrandOptions> Brand
@inject IAuthenticationService Authentication

<PageTitle>@L["Account_Forgot_PageTitle"] · @Brand.Value.ProductName</PageTitle>

<h1>@L["Account_Forgot_Title"]</h1>

@if (_sent)
{
    @* The same words whether or not that address has an account. *@
    <p>@L["Account_Forgot_Sent"]</p>
    <p class="account-form__aside"><a href="@Routes.SignIn">@L["Account_SignIn_Submit"]</a></p>
}
else
{
    <EditForm Model="Form" Context="form" FormName="forgot-password" OnValidSubmit="SubmitAsync" method="post" class="account-form">

        <p>@L["Account_Forgot_Intro"]</p>

        <TField Label="@L["Account_SignIn_Email"]" Required Error="@_emailError">
            <TInput Context="context"
                    Type="email"
                    Value="@Form.Email"
                    Required
                    name="Input.Email"
                    autocomplete="username"
                    autofocus />
        </TField>

        <TButton Type="submit" Variant="ButtonVariant.Primary">@L["Account_Forgot_Submit"]</TButton>

        <p class="account-form__aside"><a href="@Routes.SignIn">@L["Account_SignIn_Submit"]</a></p>
    </EditForm>
}

@code {
    [SupplyParameterFromForm]
    private ForgotInput? Input { get; set; }

    /// <summary>The posted values, or a fresh set the first time the page is shown.</summary>
    private ForgotInput Form => Input ??= new();

    private bool _sent;
    private string? _emailError;

    private async Task SubmitAsync()
    {
        if (string.IsNullOrWhiteSpace(Form.Email))
        {
            _emailError = L["Account_Error_EmailRequired"].Value;
            return;
        }

        await Authentication.RequestPasswordResetAsync(Form.Email);
        _sent = true;
    }

    private sealed class ForgotInput
    {
        public string Email { get; set; } = "";
    }
}
