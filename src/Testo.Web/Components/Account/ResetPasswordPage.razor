@page "/account/reset-password"
@inject IStringLocalizer<WebResources> L
@inject IOptions<BrandOptions> Brand
@inject IAuthenticationService Authentication

<PageTitle>@L["Account_Reset_PageTitle"] · @Brand.Value.ProductName</PageTitle>

<h1>@L["Account_Reset_Title"]</h1>

@if (_done)
{
    <p>@L["Account_Reset_Done"]</p>
    <p class="account-form__aside"><a href="@Routes.SignIn">@L["Account_SignIn_Submit"]</a></p>
}
else
{
    <EditForm Model="Form" Context="form" FormName="reset-password" OnValidSubmit="SubmitAsync" method="post" class="account-form">

        @* The token travels with the form so that following the link and posting it are one step
           for the person, and so the link itself is never put in a page they can share. *@
        <input type="hidden" name="Input.Token" value="@Token" />

        @if (_problem is not null)
        {
            @* An expected outcome, not a failed page: an alert in the form, not an error state. *@
        <p class="account-form__alert" role="alert">@_problem</p>
        }

        <TField Label="@L["Account_Reset_NewPassword"]" Hint="@L["Account_Reset_Hint"]" Required>
            <TInput Context="context"
                    Type="password"
                    Required
                    name="Input.NewPassword"
                    autocomplete="new-password"
                    autofocus />
        </TField>

        <TButton Type="submit" Variant="ButtonVariant.Primary">@L["Account_Reset_Submit"]</TButton>
    </EditForm>
}

@code {
    [SupplyParameterFromQuery(Name = "token")]
    private string? Token { get; set; }

    [SupplyParameterFromForm]
    private ResetInput? Input { get; set; }

    /// <summary>The posted values, or a fresh set the first time the page is shown.</summary>
    private ResetInput Form => Input ??= new();

    private bool _done;
    private string? _problem;

    private async Task SubmitAsync()
    {
        var result = await Authentication.ResetPasswordAsync(
            email: "",
            token: Form.Token ?? Token ?? "",
            newPassword: Form.NewPassword);

        if (result.Succeeded)
        {
            _done = true;
            return;
        }

        // The use cases return resource keys rather than sentences, so the message is translated
        // where it is shown.
        _problem = string.Join(" ", result.Errors.Select(error => L[error].Value));
    }

    private sealed class ResetInput
    {
        public string? Token { get; set; }

        public string NewPassword { get; set; } = "";
    }
}
