@using Microsoft.FluentUI.AspNetCore.Components
@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResources> L
@inject IOptions<BrandOptions> Brand
@inject SignedInUser Session

@*
    Layout of the product app: top bar, navigation and main region. The navigation is filled
    from the module registry in Milestone 5; until then it shows its empty state.

    The top bar carries a sign-out link rather than the user menu of Milestone 5, because the app
    now requires a session (D-1) and a product somebody cannot leave is not finished.
*@
<TSkipLink />

<div class="app-root">
<div class="app-shell">
    <header class="app-topbar">
        <a class="app-topbar__brand" href="@Routes.App" aria-label="@L["App_Header_Home", Brand.Value.ProductName]">
            <TBrand />
        </a>
        <div class="app-topbar__tools">
            <a class="app-topbar__link" href="@LocalizedPath.For(SupportedCultures.Current)">@L["App_Header_Website"]</a>
            @if (Session.DisplayName is { Length: > 0 } name)
            {
                <span class="app-topbar__person">@L["App_Header_SignedInAs", name]</span>
                <a class="app-topbar__link" href="@Routes.SignOut">@L["App_Header_SignOut"]</a>
            }
            <TLanguageSwitch />
            <TThemeSwitch />
        </div>
    </header>

    <nav class="app-nav" aria-label="@L["App_Nav_Label"]">
        <p class="app-nav__empty">@L["App_Nav_Empty"]</p>
    </nav>

    <main id="main-content" class="app-main" tabindex="-1">
        @Body
    </main>
</div>

@* Hosts the Fluent UI dialogs, tooltips, toasts and menus. *@
<FluentProviders />
</div>
