@* A link that looks like a button. It needs no JavaScript, so it also works on static pages. *@
<a class="t-link-button @VariantClass" href="@Href" @attributes="AdditionalAttributes">@ChildContent</a>

@code {
    /// <summary>The link target.</summary>
    [Parameter, EditorRequired]
    public string Href { get; set; } = "";

    /// <summary>The visual weight. Defaults to <see cref="ButtonVariant.Primary"/>.</summary>
    [Parameter]
    public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>The visible label.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>Any other attribute is passed on to the link element.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string VariantClass => Variant switch
    {
        ButtonVariant.Secondary => "t-link-button--secondary",
        _ => "t-link-button--primary",
    };
}
