<Project Sdk="Microsoft.NET.Sdk">

  <!-- The rules that protect customer data: tenant isolation, the permission table, and the
       use cases around joining and leaving. These run against a real PostgreSQL, because the
       isolation being tested is partly the database's. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Autestiq.Application\Autestiq.Application.csproj" />

    <!-- The provider adapter is not referenced by Autestiq.Application: the use cases depend on
         IScenarioPlanner in Contracts, and the host chooses the adapter. The tests see both. -->
    <ProjectReference Include="..\..\src\Autestiq.Ai\Autestiq.Ai.csproj" />
    <ProjectReference Include="..\..\src\Autestiq.Platform\Autestiq.Platform.csproj" />
    <ProjectReference Include="..\..\src\Autestiq.Export\Autestiq.Export.csproj" />
    <ProjectReference Include="..\..\tools\Autestiq.Benchmark\Autestiq.Benchmark.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- One regression fixture for the hosted run and the download (Milestone 5.1 R4). -->
    <Compile Include="../Shared/AccountValueFixture.cs" Link="Shared/AccountValueFixture.cs" />
  </ItemGroup>
</Project>
