@inject IOptions<BrandOptions> Brand

@* The brand mark (a check that flows into a node) and the product name. *@
<span class="t-brand">
    <svg class="t-brand__mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <rect class="t-brand__tile" width="32" height="32" rx="8" />
        <path class="t-brand__check" d="M7.5 15.5c2.6 1 4.4 3.1 5.9 6.6 2.3-6.4 5.8-10.4 10.6-12.8" />
        <circle class="t-brand__node" cx="24" cy="9.3" r="2.5" />
    </svg>
    <span class="t-brand__name">@Brand.Value.ProductName</span>
</span>
