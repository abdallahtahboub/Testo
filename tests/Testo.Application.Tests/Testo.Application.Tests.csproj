<Project Sdk="Microsoft.NET.Sdk">

  <!-- The rules that protect customer data: tenant isolation, the permission table, and the
       use cases around joining and leaving. These run against a real PostgreSQL, because the
       isolation being tested is partly the database's. -->

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Testo.Application\Testo.Application.csproj" />

    <!-- The provider adapter is not referenced by Testo.Application: the use cases depend on
         IScenarioPlanner in Contracts, and the host chooses the adapter. The tests see both. -->
    <ProjectReference Include="..\..\src\Testo.Ai\Testo.Ai.csproj" />
  </ItemGroup>

</Project>
