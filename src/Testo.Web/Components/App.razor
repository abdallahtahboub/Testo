@using Microsoft.AspNetCore.Diagnostics
@using System.Security.Claims
@using Testo.UI.Shared.Identity
@using Testo.Web.Identity
@inject ThemeState Theme
@inject SignedInUser Session
@inject CspNonce Nonce

@*
    The HTML document around every page.

    Two kinds of pages share it (ADR-0003):
      - public pages: rendered statically, no Blazor script at all;
      - app pages:    rendered interactively over a server connection.
    A page is public when it carries [ExcludeFromInteractiveRouting]
    (all pages of Testo.Website do); everything else is an app page.
*@
<!DOCTYPE html>
<html lang="@SupportedCultures.Current" data-theme="@ExplicitTheme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="@(ExplicitTheme ?? "light dark")" />
    <base href="/" />
    @if (IsAppPage)
    {
        <ResourcePreloader />
    }
    <link rel="preload" href="_content/Testo.UI.Shared/fonts/inter-4.001-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["_content/Testo.UI.Shared/css/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Testo.UI.Shared/css/tokens.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Testo.UI.Shared/css/base.css"]" />
    <link rel="stylesheet" href="@Assets["_content/Testo.UI.Shared/css/controls.css"]" />
    @if (IsAppPage)
    {
        @* Fluent UI, pointed at our tokens, plus the component styles of the host and the modules. *@
        <link rel="stylesheet" href="@Assets["_content/Testo.UI.Shared/css/fluent-bridge.css"]" />
        <link rel="stylesheet" href="@Assets["Testo.Web.styles.css"]" />
        @* The only inline script. The nonce tells the browser it is ours (see SecurityHeadersExtensions). *@
        <ImportMap nonce="@Nonce.Value" />
    }
    else
    {
        @* Public pages load only the component styles they use, not those of the app. *@
        <link rel="stylesheet" href="@Assets["_content/Testo.UI.Shared/Testo.UI.Shared.bundle.scp.css"]" />
        <link rel="stylesheet" href="@Assets["_content/Testo.Website/Testo.Website.bundle.scp.css"]" />
        @if (IsAccountPage)
        {
            @* The account pages are rendered statically but live in the host, so their own
               component styles are in the host bundle rather than the shared one. *@
            <link rel="stylesheet" href="@Assets["Testo.Web.styles.css"]" />
        }
    }
    <link rel="icon" type="image/svg+xml" href="@Assets["_content/Testo.UI.Shared/favicon.svg"]" />
    <LanguageAlternates />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

@* The body attributes configure the Fluent UI components of app pages: our theme, our brand color, our base styles. *@
<body no-fuib-style="@IsAppPage"
      data-theme="@(IsAppPage ? ThemeCookie.ToValue(Theme.Choice) : null)"
      data-theme-color="@(IsAppPage ? FluentTheme.BrandColor : null)">
    <CascadingValue Value="_requestedUrl" IsFixed="true">
        <AppRouter @rendermode="PageRenderMode" />
    </CascadingValue>
    @if (IsAppPage)
    {
        <ReconnectModal />
        <script src="@Assets["_framework/blazor.web.js"]"></script>
    }
    <script type="module" src="@Assets["_content/Testo.UI.Shared/js/theme.js"]"></script>
</body>

</html>

@code {
    // Supplied by the framework for every server-rendered request, so it is never null here.
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private IComponentRenderMode? PageRenderMode => HttpContext.AcceptsInteractiveRouting() ? InteractiveServer : null;

    private bool IsAppPage => PageRenderMode is not null;

    /// <summary>Signing in and the pages around it: statically rendered, but not the public site.</summary>
    private bool IsAccountPage =>
        HttpContext.Request.Path.StartsWithSegments(Routes.Account, StringComparison.OrdinalIgnoreCase);

    /// <summary>"light" or "dark" when the visitor chose one; null when the system setting decides.</summary>
    private string? ExplicitTheme => Theme.Choice == ThemeChoice.System ? null : ThemeCookie.ToValue(Theme.Choice);

    private RequestedUrl? _requestedUrl;

    /// <summary>Fills <see cref="SignedInUser"/> from the claims the session cookie carries.</summary>
    private void ReadSession()
    {
        var user = HttpContext.User;

        if (user.Identity?.IsAuthenticated != true)
        {
            return;
        }

        Session.UserId = Guid.TryParse(user.FindFirstValue(ClaimTypes.NameIdentifier), out var id) ? id : null;
        Session.Email = user.FindFirstValue(ClaimTypes.Email);
        Session.DisplayName = user.FindFirstValue(ClaimTypes.Name);
        Session.OrganizationName = user.FindFirstValue(TestoClaims.OrganizationName);

        Session.OrganizationId = Guid.TryParse(user.FindFirstValue(TestoClaims.Organization), out var organization)
            ? organization
            : null;

        Session.Role = Enum.TryParse<Role>(user.FindFirstValue(TestoClaims.Role), out var role) ? role : null;
    }

    protected override void OnInitialized()
    {
        // Read the theme cookie once per request. Rendering the theme on the server is what
        // prevents a flash of the wrong theme.
        Theme.Choice = ThemeCookie.Parse(HttpContext.Request.Cookies[ThemeCookie.Name]);

        // Read the session once per request, here, where there still is one. The values travel
        // with the prerendered page into the interactive session, which has no cookie to read.
        ReadSession();

        // When the not-found or the error page stands in for another page, links and forms
        // must keep pointing at the address the visitor asked for.
        if (HttpContext.Features.Get<IStatusCodeReExecuteFeature>() is { } missing)
        {
            _requestedUrl = new RequestedUrl(missing.OriginalPathBase + missing.OriginalPath + missing.OriginalQueryString);
        }
        else if (HttpContext.Features.Get<IExceptionHandlerPathFeature>() is { } failed)
        {
            _requestedUrl = new RequestedUrl(failed.Path + HttpContext.Request.QueryString);
        }
    }
}
