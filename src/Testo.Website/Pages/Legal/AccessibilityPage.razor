@page "/en/accessibility"
@page "/de/accessibility"
@inject IStringLocalizer<WebsiteResources> L
@inject IOptions<BrandOptions> Brand

@*
    The accessibility statement, and the one legal page that is real.

    It is real because it is the only one we can verify ourselves: every page of this site is
    scanned on every change, and the commitment below is enforced by tests rather than asserted. The
    known limitations are listed for the same reason the security page lists its gaps.
*@
<PageMeta Title="@L["Access_Title"]"
          Description="@L["Access_MetaDescription"]"
          Path="@PublicPages.Accessibility" />

<PageHero Title="@L["Access_Title"]" Lead="@L["Access_Lead"]" Narrow="true" />

<PageSection Narrow="true" Title="@L["Access_Standard_Title"]">
    <p>@L["Access_Standard_Text"]</p>
</PageSection>

<PageSection Narrow="true" Title="@L["Access_How_Title"]" Tone="PageSection.SectionTone.Subtle">
    <p>@L["Access_How_Intro"]</p>
    <ul class="legal-list">
        <li>@L["Access_How_Automated"]</li>
        <li>@L["Access_How_Keyboard"]</li>
        <li>@L["Access_How_Contrast"]</li>
        <li>@L["Access_How_Motion"]</li>
        <li>@L["Access_How_Status"]</li>
    </ul>
    <p>@L["Access_How_Limit"]</p>
</PageSection>

<PageSection Narrow="true" Title="@L["Access_Known_Title"]">
    <p>@L["Access_Known_Intro"]</p>
    <ul class="legal-list">
        <li>@L["Access_Known_Manual"]</li>
        <li>@L["Access_Known_German"]</li>
        <li>@L["Access_Known_App"]</li>
    </ul>
</PageSection>

<PageSection Narrow="true" Title="@L["Access_Feedback_Title"]" Tone="PageSection.SectionTone.Subtle">
    <p>@L["Access_Feedback_Text"]</p>
    <p>
        <TButton Href="@LocalizedPath.For(SupportedCultures.Current, PublicPages.Contact)" Variant="ButtonVariant.Primary">
            @L["Access_Feedback_Action"]
        </TButton>
    </p>
    <p class="t-muted">@L["Access_Feedback_Legal"]</p>
</PageSection>
