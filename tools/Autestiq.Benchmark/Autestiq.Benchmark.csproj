<Project Sdk="Microsoft.NET.Sdk">

  <!-- The AI benchmark: runs every controlled scenario against the deterministic baseline and
       against the planner, and writes the table ADR-0019 §7 insists on before anybody claims the
       product finds defects.

       A tool rather than a test project, because it is a measurement, not a pass or a fail, and
       because a full run takes minutes and costs money. CI runs it in smoke mode, which is one
       scenario, baseline only, no model. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Autestiq.Ai/Autestiq.Ai.csproj" />
    <ProjectReference Include="../../src/Autestiq.Application/Autestiq.Application.csproj" />
    <ProjectReference Include="../../src/Autestiq.Contracts/Autestiq.Contracts.csproj" />
    <ProjectReference Include="../../src/Autestiq.Export/Autestiq.Export.csproj" />
    <ProjectReference Include="../../src/Autestiq.DemoShop/Autestiq.DemoShop.csproj" />
    <ProjectReference Include="../../src/Autestiq.BookingShop/Autestiq.BookingShop.csproj" />
    <ProjectReference Include="../../src/Autestiq.InvoiceDesk/Autestiq.InvoiceDesk.csproj" />
    <ProjectReference Include="../../src/Autestiq.Worker/Autestiq.Worker.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
