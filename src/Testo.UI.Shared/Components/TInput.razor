@*
    A single-line text field. Always inside a TField, which gives it its label, its id and
    its description.
*@
<input class="t-input @(Context.IsInvalid ? "t-input--invalid" : null)"
       id="@Context.ControlId"
       type="@Type"
       value="@Value"
       placeholder="@Placeholder"
       required="@Required"
       disabled="@Disabled"
       readonly="@ReadOnly"
       aria-describedby="@Context.DescribedBy"
       aria-invalid="@(Context.IsInvalid ? "true" : null)"
       @oninput="OnInputAsync"
       @onchange="OnChangeAsync"
       @attributes="AdditionalAttributes" />

@code {
    /// <summary>Supplied by the <see cref="TField"/> around it.</summary>
    [Parameter, EditorRequired]
    public TFieldContext Context { get; set; }

    /// <summary>The current value.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Raised as the person types.</summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>Raised when they leave the field. Validation belongs here, not on every keystroke.</summary>
    [Parameter]
    public EventCallback<string?> OnCommitted { get; set; }

    /// <summary>The HTML input type: text, email, password, search, url, tel, number, date.</summary>
    [Parameter]
    public string Type { get; set; } = "text";

    /// <summary>An example of the expected format. Never a replacement for the label.</summary>
    [Parameter]
    public string? Placeholder { get; set; }

    /// <summary>Marks the control as required for the browser and for assistive technology.</summary>
    [Parameter]
    public bool Required { get; set; }

    /// <summary>Switches the control off.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Shows the value without allowing a change.</summary>
    [Parameter]
    public bool ReadOnly { get; set; }

    /// <summary>Any other attribute is passed on to the input.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private Task OnInputAsync(ChangeEventArgs args) => ValueChanged.InvokeAsync(args.Value?.ToString());

    private Task OnChangeAsync(ChangeEventArgs args) => OnCommitted.InvokeAsync(args.Value?.ToString());
}
