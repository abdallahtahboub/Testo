# Editor and analyzer settings for the whole repository.
# Warnings are errors (Directory.Build.props), so every severity below is a deliberate choice.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,targets,slnx,resx,xml,json,yml,yaml,css,js,svg,md}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.{cs,razor}]
# --- Style rules enforced in the build ---
csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:warning
csharp_prefer_braces = true:warning
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# --- Naming: private fields are _camelCase ---
dotnet_naming_rule.private_fields_underscore.symbols = private_fields
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_rule.private_fields_underscore.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

# --- Analyzer rules switched off, with the reason ---
# CA2007: ConfigureAwait(false) is wrong for Blazor components (they need their sync context)
#         and pointless in ASP.NET Core, which has none.
dotnet_diagnostic.CA2007.severity = none
# CA1716: "Shared" (Testo.UI.Shared) is a Visual Basic keyword; no VB code consumes these assemblies.
dotnet_diagnostic.CA1716.severity = none
# CA1054/CA1055/CA1056: relative URLs and route templates are strings throughout Blazor.
dotnet_diagnostic.CA1054.severity = none
dotnet_diagnostic.CA1055.severity = none
dotnet_diagnostic.CA1056.severity = none

[tests/**.cs]
# CA1707: test names follow MethodOrScenario_Condition_ExpectedResult.
dotnet_diagnostic.CA1707.severity = none
# CA1515: xUnit needs public test classes.
dotnet_diagnostic.CA1515.severity = none

# EF Core writes the migrations; they are generated code, not code we style or review line by
# line. Correcting them by hand would be undone the next time one is scaffolded.
[src/Testo.Persistence/Migrations/**.cs]
generated_code = true
