@*
    A single on/off choice, with its label beside it rather than above, because the label
    is the thing being switched.
*@
<div class="t-checkbox" @attributes="AdditionalAttributes">
    <input class="t-checkbox__control"
           id="@Id"
           type="checkbox"
           checked="@Checked"
           disabled="@Disabled"
           aria-describedby="@DescribedBy"
           @onchange="OnChangeAsync" />
    <label class="t-checkbox__label" for="@Id">
        @Label
        @if (!string.IsNullOrWhiteSpace(Hint))
        {
            <span class="t-checkbox__hint" id="@HintId">@Hint</span>
        }
    </label>
</div>

@code {
    /// <summary>The label beside the box. It is what gets switched, so it reads as a statement.</summary>
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    /// <summary>What the choice means, under the label.</summary>
    [Parameter]
    public string? Hint { get; set; }

    /// <summary>Whether it is on.</summary>
    [Parameter]
    public bool Checked { get; set; }

    /// <summary>Raised when it is switched.</summary>
    [Parameter]
    public EventCallback<bool> CheckedChanged { get; set; }

    /// <summary>Switches the control off.</summary>
    [Parameter]
    public bool Disabled { get; set; }

    /// <summary>Any other attribute is passed on to the wrapper.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private readonly string _id = "c" + Guid.NewGuid().ToString("N")[..8];

    private string Id => _id;

    private string HintId => _id + "-hint";

    private string? DescribedBy => string.IsNullOrWhiteSpace(Hint) ? null : HintId;

    private Task OnChangeAsync(ChangeEventArgs args) => CheckedChanged.InvokeAsync(args.Value is true);
}
