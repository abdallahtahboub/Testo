@*
    Every page of the public website uses the site layout and is rendered statically on the
    server: no interactive render mode and no Blazor script (ADR-0003).
*@
@using Microsoft.AspNetCore.Authorization

@layout SiteLayout
@attribute [ExcludeFromInteractiveRouting]

@* The whole point of a public website is that nobody has to sign in to read it (D-1). *@
@attribute [AllowAnonymous]
