@page "/not-found"
@inject IStringLocalizer<WebsiteResources> L
@inject IOptions<BrandOptions> Brand

<PageTitle>@L["NotFound_PageTitle", Brand.Value.ProductName]</PageTitle>

<StatusMessage Code="@L["NotFound_Code"]" Title="@L["NotFound_Title"]" Text="@L["NotFound_Text"]">
    <Actions>
        <TButton Href="@LocalizedPath.For(SupportedCultures.Current)" Variant="ButtonVariant.Primary">@L["NotFound_Home"]</TButton>
        <TButton Href="@Routes.App" Variant="ButtonVariant.Secondary">@L["NotFound_App"]</TButton>
    </Actions>
</StatusMessage>
